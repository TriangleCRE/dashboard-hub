# The single shared passcode for the login gate. Set the real value in
# Vercel project settings (Environment Variables) and in a local .env for
# dev — never commit the actual value.
PASSCODE=

# Postgres connection string for the dashboards table (src/db.js). In
# production this is set automatically by the Neon integration attached to
# the Vercel project. For local dev, point it at any Postgres instance —
# the app creates its own table and seed data on first request.
POSTGRES_URL=
